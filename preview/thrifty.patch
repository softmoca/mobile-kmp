@@ -0,0 +1,110 @@
+import { useState } from 'react';
+import { useLocation, useNavigate } from 'react-router-dom';
+
+import type { MapCategory } from '@/features/map/model/Map';
+import MapCanvas from '@/features/map/ui/map-canvas/MapCanvas';
+import MapCategoryRail from '@/features/map/ui/map-category-rail/MapCategoryRail';
+import MapCurrentLocationButton from '@/features/map/ui/map-current-location-button/MapCurrentLocationButton';
+import MapRadiusSelector from '@/features/map/ui/map-radius-selector/MapRadiusSelector';
+import Icon from '@/shared/ui/icon/Icon';
+
+import useGoodPriceMap from './hooks/useGoodPriceMap';
+import { RADIUS_OPTIONS, radiusLabel } from './lib/mapRadius';
+import { readMapView, writeMapView } from './lib/mapViewState';
+import MapAddressSearch from './ui/map-address-search/MapAddressSearch';
+import MapGoodPriceLayer from './ui/map-good-price-layer/MapGoodPriceLayer';
+
+import styles from './MapPage.module.css';
+import controls from './ui/map-controls/MapControls.module.css';
+import stage from './ui/map-stage/MapStage.module.css';
+
+/** 프로토타입의 알뜰 화면만 조립한다. 최신 매물 지도와 인증/레이아웃은 그대로 사용한다. */
+const MapThriftyPage = () => {
+  const location = useLocation();
+  const navigate = useNavigate();
+  const [initialView] = useState(() => readMapView(location.key, location.state));
+  const [returnKey] = useState(location.key);
+  const exploration = useGoodPriceMap(
+    initialView === undefined ? undefined : { ...initialView.center, label: '지도에서 선택한 위치' },
+    initialView?.radius ?? 1000,
+  );
+  const [isLocationOpen, setLocationOpen] = useState(false);
+  const exit = (category?: MapCategory) => {
+    writeMapView(returnKey, {
+      center: exploration.viewport,
+      level: exploration.level,
+      selectedPropertyId: null,
+      nearbyAnchor: exploration.area,
+      hasNearbyAnchor: true,
+      radius: exploration.radius,
+      categories: category === undefined ? (initialView?.categories ?? []) : [category],
+      sheetStage: 'closed',
+    });
+    navigate('/map', { state: { mapViewKey: returnKey } });
+  };
+
+  return (
+    <main className={styles.page}>
+      <MapAddressSearch
+        isOpen={false}
+        locationLabel={exploration.area.label}
+        query=""
+        results={[]}
+        status="idle"
+        onOpen={() => setLocationOpen(true)}
+        onClose={() => setLocationOpen(false)}
+        onQueryChange={() => {}}
+        onSubmit={() => {}}
+        onSelect={() => {}}
+      />
+      <section ref={exploration.mapStageRef} className={stage.mapStage} aria-label="착한가격 가게 지도">
+        <MapCanvas
+          center={exploration.viewport}
+          markers={exploration.markers}
+          circles={[{ radiusMeters: exploration.radius, label: radiusLabel(exploration.radius) }]}
+          radiusCenter={exploration.area}
+          level={exploration.level}
+          showRadiusLabels={false}
+          interactive
+          selectedMarkerId={exploration.selectedStore === null ? undefined : `store-${exploration.selectedStore.id}`}
+          onSelectMarker={(marker) => exploration.openStore(Number(marker.id.slice('store-'.length)))}
+          onSelectLocation={exploration.moveMap}
+          onCenterChange={exploration.moveMap}
+          onLevelChange={exploration.changeLevel}
+        />
+        <MapRadiusSelector
+          className={controls.radiusSelector}
+          label="착한가격 가게 확인 반경"
+          options={RADIUS_OPTIONS.map((value) => ({
+            value,
+            label: radiusLabel(value),
+            isSelected: exploration.radius === value,
+          }))}
+          onSelect={exploration.selectRadius}
+        />
+        <MapCategoryRail
+          className={controls.categoryRail}
+          selectedCategories={[]}
+          onToggle={exit}
+          extraCategory={{
+            label: '알뜰',
+            icon: <Icon name="store" size={20} />,
+            isSelected: true,
+            onToggle: () => exit(),
+          }}
+        />
+        <div className={controls.locationControls}>
+          <MapCurrentLocationButton isLocating={exploration.isLocating} onClick={() => void exploration.locate()} />
+        </div>
+        <MapGoodPriceLayer
+          exploration={exploration}
+          isLocationOpen={isLocationOpen}
+          onOpenLocation={() => setLocationOpen(true)}
+          onCloseLocation={() => setLocationOpen(false)}
+        />
+      </section>
+    </main>
+  );
+};
+
+export default MapThriftyPage;
diff --git a/frontend/src/pages/map/hooks/useGoodPriceMap.ts b/frontend/src/pages/map/hooks/useGoodPriceMap.ts
new file mode 100644
index 0000000..3ba8303
--- /dev/null
+++ b/frontend/src/pages/map/hooks/useGoodPriceMap.ts
@@ -0,0 +1,203 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router-dom';
+
+import { useGoodPriceStores } from '@/features/good-price/api/goodPriceApi';
+import type { GoodPriceResult } from '@/features/good-price/model/GoodPriceStore';
+import type { MapCoordinate } from '@/features/map/lib/mapLocation';
+import {
+  coordinatesAreClose,
+  DEFAULT_MAP_CENTER,
+  isInSouthKorea,
+  requestCurrentMapLocation,
+} from '@/features/map/lib/mapLocation';
+import { getMapFocusCenter } from '@/features/map/lib/mapViewportFocus';
+import type { MapMarker } from '@/features/map/model/Map';
+
+import useMapSheet from './useMapSheet';
+
+export type NeighborhoodArea = MapCoordinate & { label: string };
+const AREA_KEY = 'jachwi-sunbae.neighborhoodArea';
+const readArea = (): NeighborhoodArea | null => {
+  try {
+    const value = JSON.parse(window.sessionStorage.getItem(AREA_KEY) ?? 'null') as Partial<NeighborhoodArea> | null;
+    if (
+      value !== null &&
+      typeof value.label === 'string' &&
+      typeof value.latitude === 'number' &&
+      typeof value.longitude === 'number'
+    ) {
+      const area = { label: value.label, latitude: value.latitude, longitude: value.longitude };
+      if (isInSouthKorea(area)) return area;
+    }
+  } catch {
+    /* 저장소가 없어도 동네 선택을 이어간다. */
+  }
+  return null;
+};
+
+const useGoodPriceMap = (initialArea?: NeighborhoodArea, initialRadius: GoodPriceResult['radius'] = 1000) => {
+  const [params, setParams] = useSearchParams();
+  const isActive = params.get('mode') === 'thrifty';
+  const [area, setArea] = useState(() => initialArea ?? readArea() ?? { ...DEFAULT_MAP_CENTER, label: '판교 주변' });
+  const [viewport, setViewport] = useState<MapCoordinate>(area);
+  const [radius, setRadius] = useState<GoodPriceResult['radius']>(initialRadius);
+  const [level, setLevel] = useState(initialRadius === 500 ? 5 : initialRadius === 1000 ? 6 : 7);
+  const sheet = useMapSheet(isActive, params.has('store') ? 'mid' : 'closed');
+  const mapStageRef = useRef<HTMLElement | null>(null);
+  const [isMapMoved, setMapMoved] = useState(false);
+  const [isLocating, setLocating] = useState(false);
+  const [locationError, setLocationError] = useState<string | null>(null);
+  const locationRequest = useRef(0);
+  useEffect(
+    () => () => {
+      locationRequest.current += 1;
+    },
+    [isActive],
+  );
+  const query = useGoodPriceStores(isActive ? area : null, radius);
+  const data = query.isError ? undefined : query.data;
+  const selectedStore = data?.stores.find((store) => String(store.id) === params.get('store')) ?? null;
+  const markers = useMemo<MapMarker[]>(
+    () =>
+      data?.stores.map((store) => ({
+        id: `store-${store.id}`,
+        latitude: store.latitude,
+        longitude: store.longitude,
+        label: `${store.name} 상세 보기`,
+        tone: 'store',
+        actionable: true,
+      })) ?? [],
+    [data],
+  );
+
+  const chooseArea = (next: NeighborhoodArea) => {
+    locationRequest.current += 1;
+    setLocating(false);
+    setLocationError(null);
+    setArea(next);
+    setViewport(next);
+    setMapMoved(false);
+    closeStore();
+    sheet.previewSheet();
+    try {
+      window.sessionStorage.setItem(AREA_KEY, JSON.stringify(next));
+    } catch {
+      /* 탐색은 계속한다. */
+    }
+  };
+
+  const locate = async () => {
+    const request = requestCurrentMapLocation();
+    const requestId = ++locationRequest.current;
+    setLocating(true);
+    setLocationError(null);
+    try {
+      const coordinate = await request;
+      if (requestId !== locationRequest.current) return;
+      if (!isInSouthKorea(coordinate)) throw new Error('국내 위치를 선택해 주세요.');
+      chooseArea({ ...coordinate, label: '현재 위치 주변' });
+    } catch {
+      if (requestId === locationRequest.current) {
+        setLocationError('현재 위치를 확인하지 못했어요. 동네를 검색해서 선택해 주세요.');
+        setLocating(false);
+      }
+    }
+  };
+
+  const closeStore = () =>
+    setParams(
+      (previous) => {
+        const next = new URLSearchParams(previous);
+        next.delete('store');
+        return next;
+      },
+      { replace: true },
+    );
+
+  const openStore = (id: number) => {
+    const store = query.data?.stores.find((item) => item.id === id);
+    if (store === undefined) return;
+    const size = mapStageRef.current?.getBoundingClientRect();
+    setViewport(getMapFocusCenter(store, level, size?.width || 390, size?.height || 700));
+    setMapMoved(false);
+    setParams((previous) => {
+      const next = new URLSearchParams(previous);
+      next.set('store', String(id));
+      return next;
+    });
+    sheet.previewSheet();
+  };
+
+  return {
+    isActive,
+    markers,
+    enter: (next: NeighborhoodArea, nextRadius: GoodPriceResult['radius']) => {
+      locationRequest.current += 1;
+      setArea(next);
+      setViewport(next);
+      setRadius(nextRadius);
+      setLevel(nextRadius === 500 ? 5 : nextRadius === 1000 ? 6 : 7);
+      setMapMoved(false);
+      setLocating(false);
+      setLocationError(null);
+      sheet.closeSheet();
+      try {
+        window.sessionStorage.setItem(AREA_KEY, JSON.stringify(next));
+      } catch {
+        /* 탐색은 계속한다. */
+      }
+      setParams((previous) => {
+        const nextParams = new URLSearchParams(previous);
+        nextParams.set('mode', 'thrifty');
+        nextParams.delete('store');
+        return nextParams;
+      });
+    },
+    exit: () => {
+      locationRequest.current += 1;
+      setLocating(false);
+      sheet.closeSheet();
+      setParams((previous) => {
+        const next = new URLSearchParams(previous);
+        next.delete('mode');
+        next.delete('store');
+        return next;
+      });
+    },
+    changeLevel: (next: number) => setLevel(next),
+    area,
+    viewport,
+    radius,
+    level,
+    query,
+    selectedStore,
+    isLocating,
+    locationError,
+    sheet,
+    mapStageRef,
+    chooseArea,
+    locate,
+    openStore,
+    closeStore,
+    isMapMoved,
+    selectRadius: (next: GoodPriceResult['radius']) => {
+      setRadius(next);
+      setLevel(next === 500 ? 5 : next === 1000 ? 6 : 7);
+      closeStore();
+      setViewport(area);
+      setMapMoved(false);
+      sheet.previewSheet();
+    },
+    moveMap: (latitude: number, longitude: number) => {
+      const next = { latitude, longitude };
+      if (coordinatesAreClose(viewport, next)) return;
+      setViewport(next);
+      setMapMoved(!coordinatesAreClose(area, next));
+    },
+    searchMap: () => {
+      chooseArea({ ...viewport, label: '지도에서 선택한 위치' });
+    },
+  };
+};
+
+export default useGoodPriceMap;
