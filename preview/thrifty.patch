@@ -0,0 +1,40 @@
+import { NavLink, Outlet, useLocation, useOutletContext } from 'react-router-dom';
+
+import type { Member } from '@/features/auth/model/Member';
+import useIsDesktop from '@/shared/lib/hooks/useIsDesktop';
+import Icon, { type IconName } from '@/shared/ui/icon/Icon';
+
+import styles from './MobileNavigationLayout.module.css';
+
+const links: { to: string; label: string; icon: IconName }[] = [
+  { to: '/', label: '홈', icon: 'home' },
+  { to: '/checklists', label: '체크리스트', icon: 'checklist' },
+  { to: '/map', label: '지도', icon: 'map' },
+  { to: '/me', label: '마이', icon: 'user' },
+];
+
+/** 개인 Preview의 네 가지 웹 탭. 폼·상세와 데스크탑은 기존 전체 화면을 유지한다. */
+const MobileNavigationLayout = () => {
+  const member = useOutletContext<Member>();
+  const { pathname } = useLocation();
+  const isDesktop = useIsDesktop();
+  const showNavigation = !isDesktop && ['/', '/checklists', '/map', '/me', '/properties'].includes(pathname);
+  if (!showNavigation) return <Outlet context={member} />;
+  return (
+    <div className={styles.root}>
+      <div className={styles.content}>
+        <Outlet context={member} />
+      </div>
+      <nav className={styles.navigation} aria-label="주요 메뉴">
+        {links.map(({ to, label, icon }) => (
+          <NavLink key={to} to={to} end={to === '/'}>
+            <Icon name={icon} size={22} />
+            <span>{label}</span>
+          </NavLink>
+        ))}
+      </nav>
+    </div>
+  );
+};
+
+export default MobileNavigationLayout;
