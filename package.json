{
  "name": "jachwi-sunbae-mobile-docs",
  "private": true,
  "scripts": {
    "preview:prepare": "node scripts/prepare-thrifty-preview.cjs",
    "preview:save": "node scripts/save-thrifty-preview.cjs",
    "dev:preview": "node scripts/thrifty-preview.cjs",
    "verify:cheap-meals-api": "python3 scripts/verify-cheap-meals-api.py",
    "verify:preview-api": "python3 scripts/verify-thrifty-api.py",
    "dev:web": "node scripts/local-web.cjs",
    "test:webview": "sh scripts/test-webview.sh",
    "format:docs": "prettier --config .prettierrc.json --ignore-path .prettierignore --write \"*.md\" \"docs/**/*.md\"",
    "format:docs:check": "prettier --config .prettierrc.json --ignore-path .prettierignore --check \"*.md\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
